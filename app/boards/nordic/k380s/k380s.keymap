#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define FNL  1

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC    &bt BT_SEL 0  &kp C_BRI_DN   &kp C_BRI_UP    &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9    &kp F10   &kp C_MUTE   &kp C_VOL_DN    &kp C_VOL_UP   &kp DEL
&kp NON_US_BSLH   &kp N1  &kp N2   &kp N3    &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9 &kp N0    &kp MINUS &kp EQUAL  &kp BSPC
&kp TAB    &kp Q   &kp W    &kp E     &kp R   &kp T   &kp Y   &kp U   &kp I   &kp  O    &kp P     &kp LBKT  &kp RBKT   &kp RET
&kp CLCK   &kp A   &kp S    &kp D     &kp F   &kp G   &kp H   &kp J   &kp K   &kp  L    &kp SEMI  &kp SQT   &kp BSLH
&kp LSHFT  &kp GRAVE  &kp Z    &kp X     &kp C   &kp V   &kp B   &kp N   &kp M   &kp COMMA &kp DOT   &kp FSLH         &kp RSHFT
&mo FNL &kp LCTRL &kp LALT &kp LGUI             &kp SPACE                 &kp RGUI &kp RALT  &kp LEFT  &kp DOWN &kp RIGHT  &kp UP
            >;
        };

        function_layer {
            bindings = <
&bt BT_CLR &kp F1 &kp F2 &kp F3 &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9    &kp F10   &kp F11   &kp F12    &kp INS   &soft_off
&kp GRAV   &kp LS(N1)  &kp LS(N2)   &kp LS(N3)    &kp LS(N4)  &kp LS(N5)  &kp LS(N6)  &kp LS(N7)  &kp LS(N8)  &kp LS(N9)    &kp LS(N0)    &kp MINUS &kp EQUAL  &kp BSPC
&kp TAB    &kp Q        &kp W        &kp E        &kp R         &kp T   &kp Y   &kp U   &kp I   &kp  O    &kp P     &kp LBKT  &kp RBKT   &kp RET
&kp CLCK   &kp A        &kp S        &kp D        &kp F         &kp G   &kp H   &kp J   &kp K   &kp  L    &kp SEMI  &kp SQT   &kp BSLH
&kp LSHFT  &kp GRAVE       &kp Z        &kp X        &kp C         &kp V   &kp B   &kp N   &kp M   &kp COMMA &kp DOT   &kp FSLH         &kp RSHFT
&mo FNL &kp LCTRL &kp LALT &kp LGUI             &kp SPACE                 &kp RGUI &kp RALT  &kp LEFT  &kp DOWN &kp RIGHT  &kp UP
            >;
        };
    };
};
